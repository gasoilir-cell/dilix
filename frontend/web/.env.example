# Dilix Web — نمونه‌ی پیکربندی. کپی کنید به `.env.local`.
# `.env.local` هرگز کامیت نمی‌شود؛ نسخه‌ی production فقط روی سرور در
# /var/www/dilix/.env.local زندگی می‌کند.
#
# همه‌ی متغیرها `NEXT_PUBLIC_*` هستند، یعنی داخلِ باندلِ مرورگر می‌نشینند و
# **سکرت نیستند**. هیچ کلیدِ خصوصی‌ای اینجا نگذارید؛ اگر لازم شد، باید از
# Route Handler سمتِ سرور خوانده شود نه از این فایل.

# آدرسِ سرویسِ dilix-api. بدونِ اسلشِ پایانی.
NEXT_PUBLIC_API_URL=http://185.55.226.250:8000
NEXT_TELEMETRY_DISABLED=1

# ─── ورودِ اجتماعی (Client IDهای عمومیِ سمتِ مرورگر) ───
# تا پر نشدن، دکمه‌های اجتماعی پیغامِ «هنوز فعال نشده» می‌دهند و صفحه نمی‌شکند.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_AUTHORITY=
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
NEXT_PUBLIC_FACEBOOK_APP_ID=

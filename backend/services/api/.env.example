# Dilix API — نمونه‌ی پیکربندی. کپی کنید به `.env` و مقادیر واقعی را بگذارید.
# `.env` هرگز کامیت نمی‌شود. مقادیرِ production فقط روی سرور در
# /var/www/dilix-api/.env زندگی می‌کنند.

# ─── App ──────────────────────────────────────────────────────
# هشدار: نامِ متغیر دقیقاً `ENV` است، نه `ENVIRONMENT`. یک‌بار همین اشتباه باعث شد
# سرویسِ production در حالتِ development بالا بیاید (/docs باز، OTP در لاگ).
ENV=production
DEBUG=false
APP_URL=https://dilix.ir

# ─── Database / Redis ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dilix:CHANGE_ME@localhost:5432/dilix
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────
# هشدار: نامِ متغیر `JWT_SECRET` است، نه `SECRET_KEY`. حداقل ۳۲ کاراکترِ تصادفی.
JWT_SECRET=CHANGE_ME_min_32_random_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS (comma-separated، نه JSON array) ────────────────────
CORS_ORIGINS=https://dilix.ir,https://www.dilix.ir

# ─── OTP ──────────────────────────────────────────────────────
OTP_EXPIRE_SECONDS=120
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# ─── SMS ──────────────────────────────────────────────────────
SMS_PROVIDER=magfa          # console | magfa | twilio
MAGFA_USERNAME=
MAGFA_PASSWORD=
MAGFA_SENDER=Dilix
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── ورودِ اجتماعی ────────────────────────────────────────────
GOOGLE_CLIENT_IDS=          # چند مقدار با , جدا (وب + موبایل)
MICROSOFT_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── WebRTC TURN (coturn) ─────────────────────────────────────
TURN_HOST=
TURN_TLS_HOST=
TURN_SECRET=
TURN_REALM=dilix.ir
TURN_TTL=86400

# ─── Push / Payment / AI ──────────────────────────────────────
PUSHE_APP_ID=
PUSHE_TOKEN=
FCM_SERVER_KEY=
ZARINPAL_MERCHANT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_URL=http://localhost:11434
